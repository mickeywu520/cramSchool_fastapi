# Application
APP_NAME=CramSchool API
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite path, relative to container)
DATABASE_URL=sqlite+aiosqlite:///./data/cramschool.db

# JWT
SECRET_KEY=5c9c0b52b3229a18e6903d12cfa4995e7f1e02151594acb928cf9e2046722a36
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS - comma-separated origins
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200", "https://cramschool-b4d52.web.app", "https://cramschool-b4d52.firebaseapp.com", "https://www.gateway2go.bond", "https://api.gateway2go.bond", "http://www.gateway2go.bond", "http://api.gateway2go.bond", "https://www.hsedu.com.tw", "https://api.hsedu.com.tw"]

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# SMTP (Gmail 建議用應用程式密碼)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=禾笙文理補習班 <your@gmail.com>
FRONTEND_URL=http://localhost:4200

# Browser Cache (公開 GET API 的瀏覽器快取秒數)
# 九月底 production 前設 0（no-store，更新即時顯示）；production 後再調大（如 300 / 3600）
PUBLIC_CACHE_MAX_AGE=0
PUBLIC_CACHE_STALE_WHILE_REVALIDATE=86400